# Generate the first two secrets independently. Keep all three values stable
# across restarts and backups:
# python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=
DEVICE_VERIFICATION_TOKEN=
# Generate exactly 32 bytes:
# python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
DATA_ENCRYPTION_KEY=

ALLOWED_HOSTS=api.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com
API_SERVER=https://api.example.com
# For an HTTPS Web client, include the TLS reverse-proxy port explicitly.
# One WSS origin can route /ws/id and /ws/relay to ports 21118 and 21119.
ID_SERVER=wss://remote.example.com:443
RELAY_SERVER=
DEFAULT_ID_PORT=21116
RS_PUB_KEY=

API_BIND_PORT=21114
TZ=Asia/Singapore
TIME_ZONE=Asia/Singapore
LANGUAGE_CODE=zh-hans
LOG_LEVEL=INFO
ALLOW_REGISTRATION=false
SECURE_TLS=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_AGE_SECONDS=28800

# Enable client-address headers only behind a trusted reverse proxy that
# overwrites them. The Gunicorn list controls HTTPS scheme headers separately;
# when the proxy runs on the Docker host, the container usually sees its bridge
# gateway address rather than 127.0.0.1. Retain 127.0.0.1 for the internal
# readiness probe, for example "127.0.0.1,172.17.0.1". Use "*" only while
# API_BIND_PORT stays loopback-only and no untrusted container can reach this
# service.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1

# Process limits. SQLite supports one application instance; use MySQL before
# running multiple replicas.
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=60
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEP_ALIVE_SECONDS=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# Run migrations as an explicit one-off deployment step. Enabling this is only
# appropriate for a single-instance installation.
RUN_MIGRATIONS=false

DATABASE_TYPE=SQLITE
SQLITE_BUSY_TIMEOUT_SECONDS=20
INSTALL_MYSQL=false

# Recording limits and persistent destination.
RECORD_UPLOAD_MAX_CHUNK_BYTES=4194304
RECORD_UPLOAD_MAX_FILE_BYTES=10737418240

# MySQL settings are required only with DATABASE_TYPE=MYSQL. Build the image
# with INSTALL_MYSQL=true before switching.
MYSQL_DBNAME=-
MYSQL_HOST=127.0.0.1
MYSQL_USER=-
MYSQL_PASSWORD=-
MYSQL_PORT=3306
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT=10

# Optional plugin signing key: exactly 32 bytes encoded as Base64 or hex.
PLUGIN_SIGNING_KEY=

# Configure every OIDC value together or leave every value empty.
OIDC_NAME=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_HOSTS=
OIDC_SCOPE=openid email profile
OIDC_HTTP_TIMEOUT_SECONDS=10
